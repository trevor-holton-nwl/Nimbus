{
  // Config for real browser ESM modules (docs/archive/typescript_migration.md Phase 1+ —
  // frontend/**/*.mts), compiled in place to .mjs twins (gitignored). nimbus-worker.ts (a
  // classic, non-module worker script) deliberately uses the separate
  // tsconfig.worker.json instead — see that file's header comment for why a single
  // shared config can't cleanly serve both execution contexts under "nodenext".
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "frontend",
    "outDir": "frontend",
    "allowJs": false,
    "checkJs": false,
    "declaration": false,
    "noEmitOnError": true
  },
  "include": [
    "frontend/**/*.mts",
    "frontend/nimbus-compute-core.d.ts",
    "frontend/types/vendor.d.ts",
    "frontend/types/api-generated.d.mts",
    "frontend/types/nimbus-global.d.mts"
  ],
  // Compiled output lands in place, in the same directory as its source
  // (rootDir === outDir === "frontend" — see docs/archive/typescript_migration.md). TS's default
  // `exclude` is [outDir], which here would swallow the entire frontend/ tree, including
  // every file in `include` above — so it must be explicitly overridden to empty.
  "exclude": []
}
