# Secrets — never commit
.env
*.env.*
.env.local

# Node / ESLint tooling
node_modules/
.eslintcache
.worktrees/

# TypeScript compiled output — compiled in place next to its .ts/.mts source
# (see docs/archive/typescript_migration.md). Listed by specific filename, not a blanket
# *.js/*.mjs glob, so hand-written fixtures like web/_static-delivery-check.mjs
# are never accidentally ignored.
web/nimbus-worker.js
web/platform/types.mjs
web/platform/foundation.mjs
web/platform/store.mjs
web/scheduling/selection.mjs
web/optimization/sandbox.mjs
web/optimization/scheduler-contract.mjs
web/optimization/engine.mjs
web/calendar/calendar-engine.mjs
web/insights/services.mjs
web/scheduling/persistence.mjs
web/calendar/calendar-sync.mjs
web/security/session.mjs
web/scheduling/gantt.mjs
web/scheduling/orders.mjs
web/optimization/optimize-ui.mjs
web/insights/insights-ui.mjs
web/priority-lists/viewers.mjs
web/calendar/edit-calendar.mjs
web/shell/application-shell.mjs
web/master-data/material-grids.mjs
web/setup/setup-domain.mjs
web/optimization/setup-scheduler.mjs
web/master-data/admin-tables.mjs
web/shell/tab-resolvers.mjs
web/setup/setup-admin.mjs
web/calendar/calendar-admin.mjs
web/master-data/admin-ui.mjs
web/priority-lists/mapping.mjs
web/labor/labor-planning.mjs
web/admin-ops/admin-ui.mjs
web/integration/sap-interface-ui.mjs
web/security/security-admin.mjs

# Intermediate OpenAPI JSON dump (regenerated every `npm run generate:api-types`
# run) — the generated web/types/api-generated.d.mts it feeds IS committed.
web/types/.openapi-schema.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data files (binary, not source-controlled)
*.xlsx
*.xls
*.csv

# Playwright cache
.playwright-mcp/

# Test coverage outputs
.coverage
coverage/
htmlcov/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
*.suo
*.user

# Claude Code — local/transient only (skills, workflows, shared settings ARE committed)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/routines/.state/
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json
.claude/agent-memory-local
.claude/first-run
.claude/assistant-daemon-state.json

# Impeccable — local/transient only (design artifacts ARE committed)
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/config.local.json

# Superpowers subagent-driven-development — per-plan scratch workspace (ledger,
# briefs, review packages); the git history is the durable record, not this.
.superpowers/
