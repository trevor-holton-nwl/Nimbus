# VCS / planning / docs (not needed at runtime)
.git
.gitignore
.gitattributes
.planning
.claude
docs
*.md

# Python virtualenv / caches
.venv
venv
env
__pycache__
**/__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
*.egg-info

# Node / lint tooling. NOTE: package.json + package-lock.json are NOT ignored —
# the webbuild stage needs them for `npm ci` + the tsc build (see Dockerfile and
# docs/typescript_migration.md). Only node_modules and dev-only configs are stripped.
node_modules
eslint.config.js
pyproject.toml

# Tests
tests

# Secrets & local-only data
.env
.env.*
*.env

# Sample/seed spreadsheets — color wheels are uploaded at runtime to /data,
# orders are uploaded via POST /upload (parsed in memory). None ship in the image.
*.xlsx
*.XLSX

# Ad-hoc local documents (specs, notes) — not runtime content, and can be
# locked by Office while open, which breaks the ACR build's tar-upload step.
*.docx

# Editor / OS noise & scratch
.vscode
.idea
.DS_Store
Thumbs.db
desktop.ini
.playwright-mcp

# The build recipe itself
Dockerfile
.dockerignore
