      "plant_work_hours": {"0": [0, 24], "1": [0, 24], "2": [0, 24], "3": [0, 24], "4": [0, 24], "5": [0, 24], "6": [0, 24]},
      "plant_periods": [],
      "line_work_hours": {}
    },
    "holiday_period": {
