  "cases": [
    {"name": "date-only due, finishes before the close of that day: NOT late", "calendar": "weekday_8_17", "machine": "L1", "due_raw": "2026-10-28T00:00:00", "finish": "2026-10-28T14:00:00", "due": "2026-10-28T17:00:00", "late": false},
    {"name": "date-only due, finishes exactly at the close: on time", "calendar": "weekday_8_17", "machine": "L1", "due_raw": "2026-10-28T00:00:00", "finish": "2026-10-28T17:00:00", "due": "2026-10-28T17:00:00", "late": false},
    {"name": "date-only due, finishes after the close: late", "calendar": "weekday_8_17", "machine": "L1", "due_raw": "2026-10-28T00:00:00", "finish": "2026-10-28T17:30:00", "due": "2026-10-28T17:00:00", "late": true},
    {"name": "timed due is used as received", "calendar": "weekday_8_17", "machine": "L1", "due_raw": "2026-10-28T10:00:00", "finish": "2026-10-28T10:30:00", "due": "2026-10-28T10:00:00", "late": true},
    {"name": "date-only due on a closed Saturday reads the previous open day's close", "calendar": "weekday_8_17", "machine": "L1", "due_raw": "2026-10-31T00:00:00", "finish": "2026-10-30T16:00:00", "due": "2026-10-30T17:00:00", "late": false},
    {"name": "a line with its own hours closes with the intersection", "calendar": "weekday_8_17", "machine": "L2", "due_raw": "2026-10-28T00:00:00", "finish": "2026-10-28T14:30:00", "due": "2026-10-28T14:00:00", "late": true},
    {"name": "an around-the-clock plant closes at the next midnight, so any finish that day is on time", "calendar": "around_the_clock", "machine": "L1", "due_raw": "2026-10-28T00:00:00", "finish": "2026-10-28T23:30:00", "due": "2026-10-29T00:00:00", "late": false},
    {"name": "a finish after the next midnight is late", "calendar": "around_the_clock", "machine": "L1", "due_raw": "2026-10-28T00:00:00", "finish": "2026-10-29T00:30:00", "due": "2026-10-29T00:00:00", "late": true},
    {"name": "an effective-dated plant period shortens the day", "calendar": "holiday_period", "machine": "L1", "due_raw": "2026-10-28T00:00:00", "finish": "2026-10-28T12:30:00", "due": "2026-10-28T12:00:00", "late": true}
