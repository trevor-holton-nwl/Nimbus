     "required": false,
     "widget": null,
     "enum": [
      "due_date",
      "min_changeover",
      "spt"
     ],
     "enum_label_keys": {
      "due_date": "jobs.p.optimizer.plant.mode.due_date",
      "min_changeover": "jobs.p.optimizer.plant.mode.min_changeover",
      "spt": "jobs.p.optimizer.plant.mode.spt"
     }
    },
    {
     "key": "search",
