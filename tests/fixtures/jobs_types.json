      "normal": "jobs.p.optimizer.plant.search.normal",
      "exhaustive": "jobs.p.optimizer.plant.search.exhaustive"
     }
    },
    {
     "key": "respect_firmed",
     "type": "boolean",
     "label_key": "jobs.p.optimizer.plant.respect_firmed",
     "title": "Respect Firmed",
     "default": true,
     "required": false,
     "widget": null
