    {
     "key": "apply_mode",
     "type": "enum",
     "label_key": "jobs.p.optimizer.plant.apply_mode",
     "title": "Apply Mode",
     "default": "apply",
     "required": false,
     "widget": null,
     "enum": [
      "propose",
      "apply"
     ],
     "enum_label_keys": {
      "propose": "jobs.p.optimizer.plant.apply_mode.propose",
      "apply": "jobs.p.optimizer.plant.apply_mode.apply"
     }
    }
   ],
   "defaults": {
    "mode": "due_date",
    "search": "exhaustive",
    "respect_firmed": true,
